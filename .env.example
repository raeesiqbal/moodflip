NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Required by server-side profile, cleanup, and administrative routes.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Required for contact-form delivery.
RESEND_API_KEY=re_your_api_key
CONTACT_FROM_EMAIL=MoodFlip <no-reply@moodflip.coach>
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=contact@moodflip.coach
# Cloudflare Turnstile bot protection (public site key + server-only secret key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Comma-separated hostnames only; never include localhost in production.
TURNSTILE_EXPECTED_HOSTNAMES=moodflip.coach,www.moodflip.coach
# Used for password-change security notifications.
AUTH_FROM_EMAIL=MoodFlip Security <no-reply@moodflip.coach>

# Required in production for the scheduled cleanup endpoint.
CRON_SECRET=replace-with-a-long-random-value
