NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_ENABLED=false
# Optional local analytics testing only; intercept Google requests in Playwright.
NEXT_PUBLIC_GA_TEST_MODE=false

# Airwallex hosted checkout. Use sandbox values locally and never commit real
# credentials. APP_URL must be a public HTTPS URL before hosted checkout opens.
AIRWALLEX_ENV=demo
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=your-sandbox-client-id
AIRWALLEX_API_KEY=your-sandbox-api-key
# Optional unless the API key can access multiple Airwallex accounts.
AIRWALLEX_ACCOUNT_ID=
AIRWALLEX_WEBHOOK_SECRET=
NEXT_PUBLIC_AIRWALLEX_ENV=demo
APP_URL=https://your-public-https-url.example
# Local development only. Ignored when NODE_ENV=production.
DEV_COUNTRY_OVERRIDE=

# Required by server-side profile, cleanup, and administrative routes.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Required for contact-form delivery.
RESEND_API_KEY=re_your_api_key
REPORT_FROM_EMAIL=MoodFlip <no-reply@moodflip.coach>
RESEND_WEBHOOK_SECRET=whsec_your_resend_signing_secret
BUSINESS_NAME=your-registered-business-name
BUSINESS_ABN=your-australian-business-number
# Demo payments use this internal inbox unless customer delivery is explicitly enabled.
REPORT_SANDBOX_TO_EMAIL=your-internal-test-inbox@example.com
# Set to true only for a deployment where demo purchasers should receive their PDFs.
REPORT_DELIVERY_TO_CUSTOMER=false

# Optional Playwright test settings. Use a controlled account only.
PLAYWRIGHT_BASE_URL=http://localhost:3005
PLAYWRIGHT_START_SERVER=0
PLAYWRIGHT_SERVER_MODE=development
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
# Set only for a deliberate disposable-account test against the configured Supabase project.
PLAYWRIGHT_ALLOW_WRITES=0
CONTACT_FROM_EMAIL=MoodFlip <no-reply@moodflip.coach>
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=contact@moodflip.coach
# Cloudflare Turnstile bot protection (public site key + server-only secret key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Comma-separated hostnames only; never include localhost in production.
TURNSTILE_EXPECTED_HOSTNAMES=moodflip.coach,www.moodflip.coach
# Used for password-change security notifications.
AUTH_FROM_EMAIL=MoodFlip Security <no-reply@moodflip.coach>

# Required in production for the scheduled cleanup endpoint.
CRON_SECRET=replace-with-a-long-random-value
